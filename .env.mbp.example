# MBP host .env - copy to .env.mbp and fill in the secrets.
#
# This machine runs the two workers that need real CPU: the Gitea Actions
# runner and the ralphex-farm execution runner. It is a laptop only by shape -
# always on power, uptime measured in days, colima autostarted by a LaunchAgent
# with a 5-minute watchdog.
#
# Used both for ${...} interpolation in the compose files and, for the ralphex
# runner, as its container env (env_file), so every value below is either a
# path the runner needs or a credential it uses.

# --- gitea runner -----------------------------------------------------------
GITEA_RUNNER_NAME=mbp-2021-runner

# --- updater ------------------------------------------------------------------
# shared secret every /update call must carry; any long random string:
#   openssl rand -hex 24
UPDATER_KEY=
# the key the updater ssh's to this host with. Not a general one: the matching
# line in ~/.ssh/authorized_keys pins it to a forced command, so it can only run
# scripts/update-ralphex-runner.sh. Create the pair with
#   ssh-keygen -t ed25519 -N '' -C updater@mbp -f ~/.ssh/keys/updater-mbp
UPDATER_SSH_KEY=/Users/pavel.karpovich/.ssh/keys/updater-mbp
# loopback only - nothing outside this mac reaches the hook
UPDATER_PORT=8099
# how often the tick container asks whether the runner can be updated. It is a
# question, not an order: the script declines while a job is in flight or while
# the registry holds the image already running
UPDATER_TICK_INTERVAL=900

# --- ralphex runner: link to the farm ---------------------------------------
# the farm is on bravo and is reached over the LAN; runners are outbound-only
FARM_URL=http://192.168.199.72:7077
# shared secret, must match FARM_RUNNER_TOKEN in the farm's own .env
FARM_RUNNER_TOKEN=
RUNNER_NAME=mbp
# this machine is far faster than the Pi; raise once a parallel run is proven
RUNNER_SLOTS=1
# must stay below the compose stop_grace_period (3m)
RUNNER_DRAIN_TIMEOUT=2m

# --- ralphex runner: repository declarations --------------------------------
STASH_URL=https://stash.pkarpovich.space
STASH_TOKEN=

# --- ralphex runner: execution credentials ----------------------------------
# either the OAuth token or the gateway pair, not both
CLAUDE_CODE_OAUTH_TOKEN=
# fine-grained PAT: contents:write + pull_requests:write
GH_TOKEN=
FARM_GIT_USER_NAME=
FARM_GIT_USER_EMAIL=

# --- ralphex runner: task container ------------------------------------------
RALPHEX_IMAGE=git.pkarpovich.space/pkarpovich/ralphex-mise:latest
RALPHEX_WAIT_ON_LIMIT=30m

# --- host paths --------------------------------------------------------------
# each is bind-mounted at its own absolute path (see compose-ralphex-runner.yml)
# create them once: mkdir -p ~/ralphex/{repos,config,codex,claude,mise,gocache}
#
# Two of them need content, and an empty directory is worse than a missing one:
# the runner only warns when a directory is absent, so a bare mkdir silences the
# warning while leaving the job to fail late.
#   codex:  cp ~/.codex/auth.json ~/ralphex/codex/    - without it the run does
#           all its work and then dies in external review with 401 Unauthorized
#   claude: the plugins/skills config the task container copies in; leave the
#           dir empty only if you deliberately want no plugins
RUNNER_REPOS_ROOT=/Users/pavel.karpovich/ralphex/repos
RALPHEX_CONFIG_DIR=/Users/pavel.karpovich/ralphex/config
CODEX_CONFIG_DIR=/Users/pavel.karpovich/ralphex/codex
FARM_CLAUDE_CONFIG_DIR=/Users/pavel.karpovich/ralphex/claude
RALPHEX_MISE_DATA_DIR=/Users/pavel.karpovich/ralphex/mise
FARM_GO_CACHE_DIR=/Users/pavel.karpovich/ralphex/gocache
RUNNER_SSH_DIR=/Users/pavel.karpovich/.ssh

# --- container identity -------------------------------------------------------
# uid owning ~/ralphex as seen through the colima mount:
#   docker run --rm -v $HOME/ralphex:/m alpine stat -c %u /m
APP_UID=501
# gid owning the docker socket inside the colima VM:
#   docker run --rm -v /var/run/docker.sock:/s alpine stat -c %g /s
DOCKER_GID=991
# TIME_ZONE is what the umputun baseimage init reads to write /etc/localtime.
# TZ is set to the same value on purpose: the runner forwards $TZ verbatim into
# task containers, and an empty TZ means UTC to libc, which silently overrides
# whatever the init wrote (that is why ralphex logs were stamped UTC).
TIME_ZONE=Europe/Warsaw
TZ=Europe/Warsaw
