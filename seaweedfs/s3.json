{
  "identities": [
    {
      "name": "anonymous",
      "actions": [
        "Admin:agents",
        "Read:agents",
        "Write:agents",
        "List:agents",
        "Tagging:agents",
        "Admin:artifacts",
        "Read:artifacts",
        "Write:artifacts",
        "List:artifacts",
        "Tagging:artifacts",
        "Admin:conversations",
        "Read:conversations",
        "Write:conversations",
        "List:conversations",
        "Tagging:conversations",
        "Admin:execution",
        "Read:execution",
        "Write:execution",
        "List:execution",
        "Tagging:execution",
        "Admin:media",
        "Read:media",
        "Write:media",
        "List:media",
        "Tagging:media",
        "Read:obsidian",
        "Admin:oauth-tokens",
        "Read:oauth-tokens",
        "Write:oauth-tokens",
        "List:oauth-tokens",
        "Tagging:oauth-tokens",
        "Admin:settings",
        "Read:settings",
        "Write:settings",
        "List:settings",
        "Tagging:settings",
        "Admin:voice-messages",
        "Read:voice-messages",
        "Write:voice-messages",
        "List:voice-messages",
        "Tagging:voice-messages"
      ]
    },
    {
      "name": "obsidian-plugin",
      "credentials": [
        {
          "accessKey": "${OBSIDIAN_PLUGIN_ACCESS_KEY}",
          "secretKey": "${OBSIDIAN_PLUGIN_SECRET_KEY}"
        }
      ],
      "policyNames": [
        "obsidian-put"
      ]
    },
    {
      "name": "obsidian-sessions",
      "credentials": [
        {
          "accessKey": "${OBSIDIAN_SESSIONS_ACCESS_KEY}",
          "secretKey": "${OBSIDIAN_SESSIONS_SECRET_KEY}"
        }
      ],
      "policyNames": [
        "obsidian-put"
      ]
    }
  ],
  "policies": [
    {
      "name": "obsidian-put",
      "content": "{\"Version\":\"2012-10-17\",\"Statement\":[{\"Effect\":\"Allow\",\"Action\":[\"s3:PutObject\"],\"Resource\":[\"arn:aws:s3:::obsidian/*\"]}]}"
    }
  ]
}
